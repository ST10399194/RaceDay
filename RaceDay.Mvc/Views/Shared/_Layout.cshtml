<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay.Mvc</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Mvc.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @using Microsoft.AspNetCore.Http
        @{
            var role = Context.Session.GetString("Role");
            var userId = Context.Session.GetInt32("UserId");
        }

        @if (userId == null)
        {
            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Login">Login</a>
            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Register">Register</a>
        }
        else if (role == "Organiser")
        {
            <a class="nav-link text-dark" asp-controller="Organiser" asp-action="Index">Dashboard</a>
            <a class="nav-link text-dark" asp-controller="Organiser" asp-action="Events">Events</a>
            <a class="nav-link text-dark" asp-controller="Organiser" asp-action="Enrolments">Enrolments</a>
            <a class="nav-link text-dark" asp-controller="Organiser" asp-action="Results">Results</a>
        }
        else
        {
            <a class="nav-link text-dark" asp-controller="Participant" asp-action="Index">Events</a>
            <a class="nav-link text-dark" asp-controller="Participant" asp-action="MyEvents">My Events</a>
            <a class="nav-link text-dark" asp-controller="Participant" asp-action="MyResults">My Results</a>
            <a class="nav-link text-dark" asp-controller="Participant" asp-action="Profile">Profile</a>
        }

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RaceDay.Mvc - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
